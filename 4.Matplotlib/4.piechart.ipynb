    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# -------------------------------\n",
    "# STEP 1: Create Dataset (NumPy)\n",
    "# -------------------------------\n",
    "np.random.seed(0)\n",
    "\n",
    "months = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\"]\n",
    "sales = np.random.randint(2000, 10000, 6)\n",
    "profit = np.random.randint(500, 3000, 6)\n",
    "\n",
    "# Create DataFrame (Pandas)\n",
    "df = pd.DataFrame({\n",
    "    \"Month\": months,\n",
    "    \"Sales\": sales,\n",
    "    \"Profit\": profit\n",
    "})\n",
    "\n",
    "print(\"DATASET:\\n\", df)\n",
    "\n",
    "# -------------------------------\n",
    "# STEP 2: LINE CHART (Sales Trend)\n",
    "# -------------------------------\n",
    "plt.figure()\n",
    "plt.plot(df[\"Month\"], df[\"Sales\"], marker='o')\n",
    "plt.title(\"Monthly Sales Trend\")\n",
    "plt.xlabel(\"Month\")\n",
    "plt.ylabel(\"Sales\")\n",
    "plt.grid(True)\n",
    "plt.show()\n",
    "\n",
    "# -------------------------------\n",
    "# STEP 3: BAR CHART (Sales vs Profit)\n",
    "# -------------------------------\n",
    "plt.figure()\n",
    "x = np.arange(len(months))\n",
    "\n",
    "plt.bar(x - 0.2, df[\"Sales\"], width=0.4, label=\"Sales\")\n",
    "plt.bar(x + 0.2, df[\"Profit\"], width=0.4, label=\"Profit\")\n",
    "\n",
    "plt.xticks(x, months)\n",
    "plt.title(\"Sales vs Profit\")\n",
    "plt.xlabel(\"Month\")\n",
    "plt.ylabel(\"Amount\")\n",
    "plt.legend()\n",
    "plt.show()\n",
    "\n",
    "# -------------------------------\n",
    "# STEP 4: SCATTER PLOT (Relationship)\n",
    "# -------------------------------\n",
    "plt.figure()\n",
    "plt.scatter(df[\"Sales\"], df[\"Profit\"], c=df[\"Profit\"], cmap='magma')\n",
    "\n",
    "plt.colorbar(label=\"Profit Level\")\n",
    "plt.title(\"Sales vs Profit Relationship\")\n",
    "plt.xlabel(\"Sales\")\n",
    "plt.ylabel(\"Profit\")\n",
    "plt.show()\n",
    "\n",
    "# -------------------------------\n",
    "# STEP 5: PIE CHART (Total Distribution)\n",
    "# -------------------------------\n",
    "total_sales = df[\"Sales\"]\n",
    "\n",
    "plt.figure()\n",
    "plt.pie(total_sales, labels=df[\"Month\"], autopct='%1.1f%%')\n",
    "plt.title(\"Sales Distribution by Month\")\n",
    "plt.show()"
   ]
  },
